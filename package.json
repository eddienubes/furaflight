{
  "name": "@furaflight/mcp",
  "version": "0.0.1",
  "description": "MCP server exposing a flight search tool backed by flightlist.io",
  "homepage": "https://github.com/eddienubes/furaflight#readme",
  "bugs": {
    "url": "https://github.com/eddienubes/furaflight/issues"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddienubes/furaflight.git"
  },
  "bin": {
    "furaflight": "dist/furaflight"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "type": "module",
  "scripts": {
    "build": "bun build --compile --bytecode --minify --format esm --sourcemap --outfile dist/furaflight ./src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "appdirsjs": "^1.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  }
}
